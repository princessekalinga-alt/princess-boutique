{% extends 'page.html.twig' %}

{% block head %}
  {{ parent() }}
  <meta name="theme-color" content="#f8f2f1">
  <link rel="preload" as="image" href="{{ asset('images/hero-handbag.webp') }}" fetchpriority="high">
{% endblock head %}

{% block header %}
  <a class="brand-mark" href="{{ url(site.home) }}" aria-label="Princess Boutique, accueil">
    <span class="brand-monogram" aria-hidden="true">P</span>
    <span class="brand-name">Princess <span>Boutique</span></span>
  </a>
  <nav class="main-nav" aria-label="Navigation principale">
    <a href="#collection">La collection</a>
    <a href="#maison">La boutique</a>
    <a href="#avis">Vos avis</a>
    <a href="#contact">Contact</a>
  </nav>
  <a class="header-cta" href="#collection">Explorer la collection <span aria-hidden="true">↗</span></a>
{% endblock header %}

{% block content %}
  {%- set whatsapp = site.data.shop.whatsapp|default('') ~%}
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> L'élégance, à votre façon</p>
      <h1 id="hero-title">Le détail qui<br><em>change tout.</em></h1>
      <p class="hero-intro">Sacs à main et chaussures choisis pour celles qui aiment affirmer leur style, avec grâce et caractère.</p>
      <div class="hero-actions">
        <a class="button button-dark" href="#collection">Découvrir la collection <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#maison">Notre univers <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-note">
        <span class="hero-note-star" aria-hidden="true">✳</span>
        <p>Une sélection pensée<br>pour vous faire briller.</p>
      </div>
    </div>
    <div class="hero-visual">
      <img src="{{ asset('images/hero-handbag.webp') }}" alt="Sac à main élégant de la sélection Princess Boutique" width="1400" height="933" fetchpriority="high">
      <div class="hero-stamp"><span>Votre allure</span><strong>Votre histoire</strong></div>
      <span class="hero-index">COLLECTION · 01</span>
    </div>
  </section>

  <section class="promise-strip" aria-label="L'esprit Princess Boutique">
    <p>DES PIÈCES QUI VOUS RESSEMBLENT</p><span aria-hidden="true">✳</span>
    <p>DU STYLE EN TOUTE SIMPLICITÉ</p><span aria-hidden="true">✳</span>
    <p>VOTRE PROCHAIN COUP DE CŒUR</p>
  </section>

  <section class="section collection-section" id="collection" aria-labelledby="collection-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow"><span></span> La sélection du moment</p>
        <h2 id="collection-title">Les pièces <em>à aimer.</em></h2>
      </div>
      <p class="section-aside">Des accessoires qui font toute la différence.<br>Et si votre prochain coup de cœur était ici&nbsp;?</p>
    </div>
    <div class="product-grid">
      {%- for product in site.data.products ~%}
      <article class="product-card">
        <a class="product-image" href="https://wa.me/{{ whatsapp|e('html_attr') }}?text={{ ('Bonjour Princess Boutique, je souhaite en savoir plus sur ' ~ product.name)|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Commander {{ product.name|e }} sur WhatsApp">
          <img src="{{ asset(product.image) }}" alt="{{ product.alt|e }}" width="800" height="1000" loading="lazy" decoding="async">
          <span class="product-label">{{ product.label|e }}</span>
          <span class="product-arrow" aria-hidden="true">↗</span>
        </a>
        <div class="product-info">
          <div><h3>{{ product.name|e }}</h3><p>{{ product.category|e }}</p></div>
          <a class="product-order" href="https://wa.me/{{ whatsapp|e('html_attr') }}?text={{ ('Bonjour Princess Boutique, je souhaite en savoir plus sur ' ~ product.name)|url_encode }}" target="_blank" rel="noopener noreferrer">Demander le prix <span aria-hidden="true">↗</span></a>
        </div>
      </article>
      {%- endfor ~%}
    </div>
    <p class="catalog-note">Pour connaître les disponibilités et les prix, écrivez-nous directement.</p>
  </section>

  <section class="editorial" id="maison" aria-labelledby="editorial-title">
    <div class="editorial-image">
      <img src="{{ asset('images/fashion-edit.webp') }}" alt="Une silhouette élégante, libre et affirmée" width="1200" height="800" loading="lazy" decoding="async">
      <span class="editorial-caption">L'allure est une attitude.</span>
    </div>
    <div class="editorial-copy">
      <p class="eyebrow"><span></span> La maison Princess</p>
      <h2 id="editorial-title">Le style n'a<br>pas besoin de<br><em>permission.</em></h2>
      <p>Princess Boutique est née d'une envie simple&nbsp;: vous proposer des accessoires qui célèbrent votre personnalité. Des sacs qui attirent le regard, des chaussures qui vous portent avec assurance — et toujours, le plaisir de choisir une pièce qui vous ressemble.</p>
      <a class="text-link" href="{{ url(site.home) }}about/">En savoir plus sur nous <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="quote-section" id="avis" aria-labelledby="quote-title">
    <p class="eyebrow"><span></span> Vos mots, votre style</p>
    <h2 id="quote-title">Bientôt, vos histoires<br><em>et vos coups de cœur.</em></h2>
    <p class="quote-note">Nous préparons cet espace pour accueillir les retours authentiques de nos clientes. Vous avez déjà trouvé votre pièce préférée&nbsp;? Racontez-nous.</p>
    <a class="button button-outline" href="https://wa.me/{{ whatsapp|e('html_attr') }}?text={{ 'Bonjour Princess Boutique, je souhaite partager mon avis.'|url_encode }}" target="_blank" rel="noopener noreferrer">Partager mon expérience <span aria-hidden="true">↗</span></a>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div class="contact-copy">
      <p class="eyebrow"><span></span> Restons en contact</p>
      <h2 id="contact-title">On vous <em>écoute.</em></h2>
      <p>Une question sur une pièce, une envie de conseil ou une commande en tête&nbsp;? Écrivez-nous, nous serons ravies d'échanger avec vous.</p>
      <a class="contact-whatsapp" href="https://wa.me/{{ whatsapp|e('html_attr') }}?text={{ 'Bonjour Princess Boutique, je vous contacte depuis votre site.'|url_encode }}" target="_blank" rel="noopener noreferrer">
        <span class="whatsapp-icon" aria-hidden="true">↗</span>
        <span><strong>Écrivez-nous sur WhatsApp</strong><small>Pour une réponse personnalisée</small></span>
        <span class="contact-arrow" aria-hidden="true">→</span>
      </a>
      {%- if site.data.shop.email|default('') ~%}
      <p class="contact-email">Ou par e-mail&nbsp;: <a href="mailto:{{ site.data.shop.email|e('html_attr') }}">{{ site.data.shop.email|e }}</a></p>
      {%- endif ~%}
    </div>
    <form class="contact-form" action="mailto:{{ site.data.shop.email|default('')|e('html_attr') }}" method="post" enctype="text/plain">
      <label for="contact-name">Votre nom</label>
      <input id="contact-name" name="Nom" type="text" autocomplete="name" placeholder="Comment vous appelez-vous ?" required>
      <label for="contact-email">Votre e-mail</label>
      <input id="contact-email" name="E-mail" type="email" autocomplete="email" placeholder="vous@exemple.com" required>
      <label for="contact-message">Votre message</label>
      <textarea id="contact-message" name="Message" rows="4" placeholder="Dites-nous tout..." required></textarea>
      <button class="button button-dark" type="submit">Préparer mon message <span aria-hidden="true">↗</span></button>
      <small>Votre application e-mail s'ouvrira pour envoyer votre message. Configurez l'adresse de la boutique pour recevoir les demandes.</small>
    </form>
  </section>

  <section class="social-band" aria-label="Réseaux sociaux">
    <p>Un peu de Princess dans votre fil&nbsp;?</p>
    <div>
      {%- if site.data.shop.instagram|default('') ~%}
      <a href="{{ site.data.shop.instagram|e('html_attr') }}" target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
      {%- else ~%}
      <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
      {%- endif ~%}
      {%- if site.data.shop.facebook|default('') ~%}
      <a href="{{ site.data.shop.facebook|e('html_attr') }}" target="_blank" rel="noopener noreferrer">Facebook <span aria-hidden="true">↗</span></a>
      {%- else ~%}
      <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer">Facebook <span aria-hidden="true">↗</span></a>
      {%- endif ~%}
    </div>
  </section>
{% endblock content %}

{% block footer %}
  <div class="footer-main">
    <a class="brand-mark footer-logo" href="{{ url(site.home) }}">
      <span class="brand-monogram" aria-hidden="true">P</span>
      <span class="brand-name">Princess <span>Boutique</span></span>
    </a>
    <p>Le détail qui change tout.<br>À vous de l'écrire.</p>
    <a class="footer-top" href="#main">Retour en haut <span aria-hidden="true">↑</span></a>
  </div>
  {{- include('partials/shop-footer-links.html.twig', {}, with_context=false) ~}}
  <div class="footer-bottom">
    <small>&copy; {{ 'now'|date('Y') }} Princess Boutique. Tous droits réservés.</small>
    <small>Les visuels présentés sont des images d'illustration.</small>
  </div>
{% endblock footer %}
